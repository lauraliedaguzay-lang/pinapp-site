# Copier vers pinapp-automation.env (non versionne) ou definir les memes cles en secrets GitHub Actions.
# Le build (.\pinapp.ps1 build ou npm run build) injecte ces valeurs dans _site/ uniquement.

# Instance n8n — une des deux lignes suffit :
# PINAPP_N8N_BASE_URL=https://VOTRE_SOUS_DOMAINE.n8n.cloud
# PINAPP_N8N_HOST=VOTRE_SOUS_DOMAINE.n8n.cloud

# ID du formulaire Tally diagnostic (segment d URL apres https://tally.so/embed/ )
# PINAPP_TALLY_DIAGNOSTIC_DEFAULT=

# Kill switch : garder les webhooks dans config mais forcer les flags a false
# PINAPP_DISABLE_AUTOMATION_FEATURES=0
