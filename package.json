{
  "name": "pinapp-site",
  "private": true,
  "type": "module",
  "description": "Site vitrine Pinapp — défaut : PowerShell .\\pinapp.ps1 (dev/ci/build/verify). npm run * délègue au même script (sans récursion).",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 dev",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 build",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 verify",
    "conformite": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 conformite",
    "ci": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 ci",
    "format": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 format",
    "format:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 format-check",
    "pinapp": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-local.ps1",
    "pr": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-pr.ps1",
    "ship": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 ship",
    "tout": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-tout.ps1",
    "tout:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-tout.ps1 -SkipPush",
    "dormir": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-dormir.ps1",
    "applique": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-applique-tout.ps1",
    "orchestrate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-orchestrate.ps1",
    "relie": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-relie-tout.ps1",
    "merge-deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-merge-deploy-main.ps1",
    "publie": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-publie.ps1",
    "auto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pinapp-relie-tout.ps1 -SkipN8n",
    "qr:diagnostic": "node tools/generate-qr.mjs",
    "build:demo-zip": "node tools/build-demo-zip.mjs",
    "build:demo-screens": "node tools/build-demo-screens.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "prettier": "^3.5.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
