{
  "name": "pinapp-site",
  "private": true,
  "type": "module",
  "description": "Site vitrine Pinapp — défaut Windows : PowerShell .\\pinapp.ps1 (ou npm run ship | pinapp | tout). Node : dev/build/ci.",
  "scripts": {
    "dev": "vite --host",
    "build": "node tools/build-site.mjs",
    "verify": "node tools/verify-site.mjs",
    "ci": "npm run format:check && npm run verify",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md,yml}\"",
    "pinapp": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1",
    "ship": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp.ps1 ship",
    "tout": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-tout.ps1",
    "tout:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-tout.ps1 -SkipPush",
    "dormir": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-dormir.ps1",
    "applique": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-applique-tout.ps1",
    "orchestrate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-orchestrate.ps1",
    "relie": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-relie-tout.ps1",
    "merge-deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-merge-deploy-main.ps1",
    "publie": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-publie.ps1",
    "auto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./pinapp-relie-tout.ps1 -SkipN8n"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
