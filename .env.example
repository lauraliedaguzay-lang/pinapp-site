# Variables optionnelles pour builds locaux (copier en .env — non versionné)
# Injection dans _site/assets/js/auralis-config.js lors du build (.\pinapp.ps1 build ou npm run build) si défini :
# AURALIS_APP_URL=https://app.exemple.fr

# Page /voyage/ — webhooks n8n (optionnel, sinon configurer dans assets/js/config-voyage.js)
N8N_WEBHOOK_DIAGNOSTIC=
N8N_WEBHOOK_NEWSLETTER=
N8N_WEBHOOK_PARRAINAGE=
