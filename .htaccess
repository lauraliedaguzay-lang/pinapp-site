# Pas de listing de répertoires
Options -Indexes

# Évite les 403 sur hébergeurs qui ne résolvent pas index.html implicitement
DirectoryIndex index.html

# HTTPS forcé
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Compression Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Protection /dashboard/ : voir dashboard/.htaccess (évite les directives <If> peu fiables sous LiteSpeed)

# --- Content-Security-Policy (Pinapp) ---
# Compat : styles inline massifs ; scripts inline (JSON-LD accueil + config démos sectorielles) ;
# bruit SVG en data: dans le CSS ; iframe démos sur /realisations/ (même origine).
# Plausible : script + envoi d’événements sur https://plausible.io (retirer si vous n’activez pas l’outil).
# Domaine Plausible personnalisé : ajoutez-le dans script-src et connect-src (ex. https://analytics.pinapp.fr).
# Webhooks (Make, Brevo, etc.) : ajoutez l’URL HTTPS exacte dans connect-src quand vous branchez les formulaires.
# Durcir plus tard : nonces + externaliser la config démo → retirer 'unsafe-inline' pour script-src.
<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://pinapp.fr; frame-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://plausible.io; form-action 'self'; upgrade-insecure-requests;"

# APIs navigateur inutiles ici (réduit la surface)
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

# Headers sécurité
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# Décommenter après validation HTTPS stable (sinon risque de bloquer des sous-domaines de test)
# Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 404 custom
ErrorDocument 404 /404.html
