# Copier vers .env.local à la racine du dépôt (non versionné : .env.* est ignoré par git).
# Ne jamais committer de mots de passe, tokens ou clés API.

# --- VPS Hostinger (Phase 1.1) ---
VPS_HOST=
VPS_USER=root
# VPS_PASSWORD=  # préférer clé SSH ; si mot de passe, uniquement hors git

# --- Telegram @pinapp_ops_bot (Phase 1.3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_LAURALIE=

# --- Anthropic (Phase 1.4 — credentials n8n recommandés en prod) ---
# ANTHROPIC_API_KEY=  # plutôt stocker dans n8n Credentials, pas en clair local

# --- n8n (référence — voir aussi pinapp-automation.env.example) ---
# PINAPP_N8N_BASE_URL=https://...
