---
import { HamburgerMenu } from './HamburgerMenu';
---

<nav
  class="pointer-events-none fixed left-0 right-0 top-0 z-[100] flex items-center justify-between px-[4vw] py-6 mix-blend-difference"
  aria-label="Navigation principale"
>
  <div
    class="marque pointer-events-auto font-body text-[0.7rem] font-extralight uppercase tracking-[0.4em] text-or-rose"
    style="font-weight: 200;"
  >
    MAISON ORIANE
  </div>
  <div class="flex items-center gap-2">
    <div
      class="menu pointer-events-auto hidden gap-7 font-body text-[0.7rem] font-light uppercase tracking-[0.3em] text-ivoire md:flex"
      style="font-weight: 300;"
    >
      <a
        href="#manifesto"
        class="text-inherit no-underline transition-colors duration-300 hover:text-or-rose"
        >Manifeste</a
      >
      <a
        href="#collection"
        class="text-inherit no-underline transition-colors duration-300 hover:text-or-rose"
        >Collection</a
      >
      <a
        href="#contact"
        class="text-inherit no-underline transition-colors duration-300 hover:text-or-rose"
        >Contact</a
      >
    </div>
    <HamburgerMenu client:load />
  </div>
</nav>
