---
interface Props {
  notes: string[];
  variant?: 'dark' | 'light';
}

const { notes, variant = 'dark' } = Astro.props;
---

<section class="marquee" data-variant={variant} aria-label="Notes olfactives">
  <div class="marquee-track">
    <div class="marquee-segment">
      {
        notes.map((note) => (
          <>
            <span class="marquee-item">{note}</span>
            <span class="marquee-diamond">◆</span>
          </>
        ))
      }
    </div>
    <div class="marquee-segment" aria-hidden="true">
      {
        notes.map((note) => (
          <>
            <span class="marquee-item">{note}</span>
            <span class="marquee-diamond">◆</span>
          </>
        ))
      }
    </div>
  </div>
</section>
