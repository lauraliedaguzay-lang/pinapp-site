---
import '../styles/global.css';
import { Preloader } from '../components/Preloader.tsx';
import Nav from '../components/Nav.astro';
import { LosangeCursor } from '../components/LosangeCursor.tsx';
import { SparkleRainHost } from '../components/canvas/SparkleRainHost.tsx';

interface Props {
  title?: string;
  description?: string;
}

const title = 'Maison ORIANE — Parfumerie niche · Bordeaux 2026';
const description =
  'Maison ORIANE — trois fragrances pour trois aubes. Création sur mesure, parfumerie niche. Bordeaux 2026.';
const canonical = 'https://pinapp.fr/demo/oriane/';
const ogImage = `${canonical}og-oriane.jpg`;

const schemaLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Maison ORIANE',
  url: canonical,
  logo: ogImage,
  description: 'Parfumerie niche bordelaise. Trois fragrances pour trois aubes.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bordeaux',
    addressCountry: 'FR',
  },
  email: 'contact@maisonoriane.example',
  founder: {
    '@type': 'Organization',
    name: 'Pinapp Studio',
  },
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Pinapp Studio" />
    <meta name="theme-color" content="#1A1614" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Maison ORIANE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={schemaLd} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-body bg-ivoire text-encre antialiased">
    <Preloader client:load />
    <Nav />
    <LosangeCursor client:idle />
    <SparkleRainHost client:load />
    <slot />
  </body>
</html>
