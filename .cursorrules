```svg
<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 32 38" width="32" height="38">
  <style>
    @keyframes breathe {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.85; transform: scale(1.008); }
    }
    g { animation: breathe 4s ease-in-out infinite;
        transform-origin: center; }
  </style>
  <g fill="none" stroke="#00E5CC" stroke-width="1.5"
     stroke-linecap="round" stroke-linejoin="round">
    <!-- Feuilles -->
    <path d="M16 2 C13 5 10 6 11 9"/>
    <path d="M16 2 L16 9"/>
    <path d="M16 2 C19 5 22 6 21 9"/>
    <!-- Corps -->
    <ellipse cx="16" cy="24" rx="9" ry="12"/>
    <!-- Losanges -->
    <path d="M7 20 L16 15 L25 20 L16 25 Z"/>
    <path d="M7 26 L16 21 L25 26 L16 31 Z"/>
  </g>
</svg>
```

