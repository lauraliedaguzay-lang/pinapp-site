## PALETTE PANDORA — OFFICIELLE ET UNIQUE

### variables.css — importé EN PREMIER dans chaque page

```css
/* PINAPP — variables.css v4.0 */

@media (prefers-color-scheme: dark) {
  :root {
    --bg-primary:     #050A14;
    --bg-card:        #0A1628;
    --bg-overlay:     rgba(5,10,20,0.95);
    --bg-deep:        #0D0D1A;
    --text-primary:   #E8F4F8;
    --text-secondary: rgba(232,244,248,0.6);
    --text-tertiary:  rgba(232,244,248,0.4);
    --accent-teal:    #00E5CC;
    --accent-violet:  #7B4FE8;
    --accent-green:   #39E075;
    --accent-blue:    #4FC3F7;
    --glow-teal:      rgba(0,229,204,0.08);
    --glow-teal-lg:   rgba(0,229,204,0.04);
    --separator:      rgba(79,195,247,0.15);
    --border-card:    rgba(0,229,204,0.08);
    --nav-bg:         rgba(5,10,20,0.85);
  }
}

@media (prefers-color-scheme: light) {
  :root {
    --bg-primary:     #FDF0F3;
    --bg-secondary:   #EEF0FF;
    --bg-card:        #FFF5F7;
    --bg-overlay:     rgba(253,240,243,0.95);
    --bg-deep:        #F0EEF5;
    --text-primary:   #0D1B3E;
    --text-secondary: rgba(13,27,62,0.6);
    --text-tertiary:  rgba(13,27,62,0.4);
    --accent-teal:    #00B4A6;
    --accent-violet:  #5B4FE8;
    --accent-green:   #2EAF6B;
    --accent-rose:    #F4A0B0;
    --separator:      rgba(13,27,62,0.08);
    --border-card:    rgba(91,79,232,0.08);
    --nav-bg:         rgba(253,240,243,0.85);
  }
}

/* Transition mode nuit/jour */
body, .card, .nav, header, footer,
section, .btn, input, textarea {
  transition: background-color 500ms ease,
              color 500ms ease,
              border-color 500ms ease;
}

/* Gradient violet profondeur fond nuit */
@media (prefers-color-scheme: dark) {
  body::before {
    content: '';
    position: fixed; inset: 0;
    background: radial-gradient(
      ellipse 40% 40% at 0% 100%,
      rgba(123,79,232,0.03), transparent);
    pointer-events: none; z-index: 0;
  }
}

/* Système 8px */
:root {
  --space-1: 8px;   --space-2: 16px;
  --space-3: 24px;  --space-4: 32px;
  --space-5: 48px;  --space-6: 64px;
  --space-7: 80px;  --space-8: 96px;
  --space-9: 120px;
}

/* Border radius */
:root {
  --radius-pill:    100px;
  --radius-card:    16px;
  --radius-card-lg: 20px;
  --radius-input:   12px;
  --radius-modal:   24px;
}

/* Timing */
:root {
  --t-press:    80ms ease;
  --t-hover:    200ms cubic-bezier(0.25,0.1,0.25,1);
  --t-standard: 300ms cubic-bezier(0.25,0.1,0.25,1);
  --t-enter:    600ms cubic-bezier(0.25,0.1,0.25,1);
  --t-breathe:  4s ease-in-out infinite;
  --t-aurora:   12s ease infinite;
}

/* Typographie */
:root {
  --text-hero:  clamp(48px, 8vw, 96px);
  --text-h1:    clamp(32px, 5vw, 64px);
  --text-h2:    clamp(24px, 3vw, 48px);
  --text-h3:    clamp(18px, 2vw, 32px);
  --text-body:  16px;
  --text-label: 11px;
  --text-cta:   14px;
  --text-legal: 9px;
}

/* Barres progression — vert TOUJOURS */
@media (prefers-color-scheme: dark) {
  [class*="progress"], .onboarding-bar,
  .scroll-bar, .auralis-bar {
    background: linear-gradient(90deg,
      var(--accent-green), var(--accent-teal)) !important;
    box-shadow: 0 0 12px rgba(57,224,117,0.3);
    border-radius: 100px;
  }
}
@media (prefers-color-scheme: light) {
  [class*="progress"], .onboarding-bar,
  .scroll-bar, .auralis-bar {
    background: linear-gradient(90deg,
      #2EAF6B, #00B4A6) !important;
    border-radius: 100px;
  }
}
```

### animations.css — bibliothèque complète

```css
/* PINAPP — animations.css v4.0 */

/* ① Respiration signature — logo + CTA */
@keyframes breathe {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.85; transform: scale(1.008); }
}
.pinapp-breathe {
  animation: breathe var(--t-breathe);
  will-change: opacity, transform;
}

/* ② Aurora background */
@keyframes aurora {
  0%   { background-position: 0% 50%;   opacity: 0.05; }
  50%  { background-position: 100% 50%; opacity: 0.07; }
  100% { background-position: 0% 50%;   opacity: 0.05; }
}
.aurora-bg {
  background: linear-gradient(135deg,
    rgba(0,229,204,0.08), rgba(123,79,232,0.06),
    rgba(57,224,117,0.05), rgba(0,229,204,0.08));
  background-size: 400% 400%;
  animation: aurora var(--t-aurora);
  will-change: background-position, opacity;
}

/* ③ Grain noise */
.noise-overlay {
  position: fixed; inset: 0;
  pointer-events: none; z-index: 1;
  background-image: url("data:image/svg+xml,<svg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
}
@media (prefers-color-scheme: dark) {
  .noise-overlay { opacity: 0.035; mix-blend-mode: overlay; }
}
@media (prefers-color-scheme: light) {
  .noise-overlay { opacity: 0.025; mix-blend-mode: multiply; }
}

/* ④ Scroll progress */
.scroll-progress {
  position: fixed; top: 0; left: 0;
  height: 2px; z-index: 1000;
  background: linear-gradient(90deg, #39E075, #00E5CC);
  transform-origin: left; transform: scaleX(0);
  transition: transform 100ms linear;
  will-change: transform;
}

/* ⑤ Nav scroll-aware */
.nav { transition: transform var(--t-standard), background 300ms ease; }
.nav.nav-hidden { transform: translateY(-100%); }

/* ⑥ Nav link underline */
.nav-link { position: relative; text-decoration: none; }
.nav-link::after {
  content: ''; position: absolute;
  bottom: -2px; left: 0; width: 0; height: 1px;
  background: var(--accent-teal);
  transition: width var(--t-hover);
}
@media (hover: hover) { .nav-link:hover::after { width: 100%; } }

/* ⑦ Section entrées scroll */
.section-enter {
  opacity: 0; transform: translateY(16px);
  transition: opacity var(--t-enter), transform var(--t-enter);
}
.section-enter.visible { opacity: 1; transform: translateY(0); }
.stagger-0 { transition-delay: 0ms; }
.stagger-1 { transition-delay: 80ms; }
.stagger-2 { transition-delay: 160ms; }
.stagger-3 { transition-delay: 240ms; }
.stagger-4 { transition-delay: 320ms; }

/* ⑧ Hero mots */
.hero-word {
  opacity: 0; transform: translateY(12px);
  display: inline-block;
  transition: opacity 400ms ease, transform 400ms ease;
}
.hero-word.visible { opacity: 1; transform: translateY(0); }
.hero-word.accent  { color: var(--accent-teal); }

/* ⑨ Hero éléments */
.hero-el {
  opacity: 0; transform: translateY(16px);
  transition: opacity var(--t-enter), transform var(--t-enter);
}
.hero-el.visible { opacity: 1; transform: translateY(0); }
.hero-cta {
  opacity: 0; transform: scale(0.96);
  transition: opacity 300ms ease, transform 300ms ease;
}
.hero-cta.visible { opacity: 1; transform: scale(1); }

/* ⑩ Scroll chevron */
@keyframes bounce-chevron {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50%       { transform: translateY(6px); opacity: 1; }
}
.scroll-chevron { animation: bounce-chevron 1.5s ease-in-out infinite; }

/* ⑪ Cards hover */
@media (hover: hover) {
  .card {
    transition: transform var(--t-hover), box-shadow var(--t-hover);
  }
  .card:hover {
    transform: translateY(-3px) scale(1.005);
    box-shadow:
      0 0 40px rgba(0,229,204,0.08),
      0 0 80px rgba(0,229,204,0.04),
      0 0 120px rgba(0,229,204,0.02);
  }
}
.card:active { transform: scale(0.98); transition: transform var(--t-press); }

/* ⑫ Boutons */
.btn:active { transform: scale(0.97); transition: transform var(--t-press); }
.btn-secondary .arrow {
  display: inline-block;
  transition: transform var(--t-hover);
}
@media (hover: hover) {
  .btn-secondary:hover .arrow { transform: translateX(4px); }
}

/* ⑬ CTA principal — breathe uniquement, zéro shimmer */
.btn-primary { animation: breathe var(--t-breathe); }

/* ⑭ Switcher démo */
.demo-tab { transition: background var(--t-hover), color var(--t-hover); }
.demo-panel { opacity: 0; transition: opacity 200ms ease; pointer-events: none; position: absolute; }
.demo-panel.active { opacity: 1; pointer-events: auto; position: relative; }

/* ⑮ Pipeline */
.pipeline-block {
  opacity: 0; transform: translateX(-8px);
  transition: opacity 300ms ease, transform 300ms ease;
}
.pipeline-block.active { opacity: 1; transform: translateX(0); }
.pipeline-line {
  width: 0; height: 2px;
  background: linear-gradient(90deg, #39E075, #00E5CC);
  transition: width var(--t-standard); border-radius: 100px;
}
.pipeline-line.active { width: 100%; }

/* ⑯ Checkmark SVG */
@keyframes check-draw {
  from { stroke-dashoffset: 100; }
  to   { stroke-dashoffset: 0; }
}
.checkmark path {
  stroke-dasharray: 100; stroke-dashoffset: 100;
  animation: check-draw 300ms ease forwards;
}

/* ⑰ Typing indicator */
@keyframes typing-dot {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30%           { transform: translateY(-4px); opacity: 1; }
}
.typing-dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--accent-teal); display: inline-block;
}
.typing-dot:nth-child(1) { animation: typing-dot 1s ease infinite 0ms; }
.typing-dot:nth-child(2) { animation: typing-dot 1s ease infinite 150ms; }
.typing-dot:nth-child(3) { animation: typing-dot 1s ease infinite 300ms; }

/* ⑱ Point LIVE */
@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}
.live-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #00E5CC; display: inline-block;
  animation: live-pulse 2s linear infinite;
}

/* ⑲ Onboarding questions */
.question {
  opacity: 0; transform: translateY(8px);
  pointer-events: none;
  transition: opacity 400ms ease, transform 400ms ease;
}
.question.active { opacity: 1; transform: translateY(0); pointer-events: auto; }
@keyframes fade-msg {
  0%   { opacity: 0; transform: scale(0.95); }
  40%  { opacity: 1; transform: scale(1); }
  70%  { opacity: 1; }
  100% { opacity: 0; transform: scale(1.02); }
}
.transition-msg { animation: fade-msg 600ms ease forwards; }
@keyframes check-final {
  0%   { transform: scale(0); opacity: 0; }
  60%  { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
.check-final { animation: check-final 300ms cubic-bezier(0.25,0.1,0.25,1) forwards; }

/* ⑳ Réalisations modal */
.modal { opacity: 0; visibility: hidden; transition: opacity var(--t-standard), visibility var(--t-standard); }
.modal.open { opacity: 1; visibility: visible; }
.modal-content { transform: scale(0.96); transition: transform var(--t-standard); }
.modal.open .modal-content { transform: scale(1); }
@keyframes skeleton-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.skeleton-pulse {
  width: 200px; height: 4px; border-radius: 100px;
  background: linear-gradient(90deg,
    var(--bg-card) 25%, var(--accent-teal) 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease infinite;
}

/* ㉑ FAQ accordéon */
.faq-content { max-height: 0; overflow: hidden; opacity: 0;
  transition: max-height var(--t-standard), opacity var(--t-standard); }
.faq-item.open .faq-content { max-height: 300px; opacity: 1; }
.faq-chevron { transition: transform var(--t-standard); }
.faq-item.open .faq-chevron { transform: rotate(180deg); }

/* ㉒ Loader */
#loader { transition: opacity var(--t-standard), visibility var(--t-standard); }
#loader.hidden { opacity: 0; visibility: hidden; }

/* ㉓ Cards réalisations */
@media (hover: hover) {
  .realisation-card { transition: transform var(--t-hover), box-shadow var(--t-hover); }
  .realisation-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 40px rgba(0,229,204,0.08),
      0 0 80px rgba(0,229,204,0.04);
  }
}

/* ㉔ Étapes process */
@keyframes step-appear {
  from { opacity: 0; transform: translateX(-16px); }
  to   { opacity: 1; transform: translateX(0); }
}
.step-item { opacity: 0; }
.step-item.visible {
  animation: step-appear 500ms cubic-bezier(0.25,0.1,0.25,1) forwards;
}

/* ACCESSIBILITÉ — obligatoire en dernier */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .section-enter, .hero-el, .hero-word,
  .hero-cta, .question { opacity: 1 !important; transform: none !important; }
  .pinapp-breathe, .aurora-bg, .noise-overlay,
  .live-dot, .scroll-chevron { animation: none !important; }
}
```

### grid.css

```css
/* PINAPP — grid.css v4.0 */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: auto; -webkit-text-size-adjust: 100%; }
body {
  font-family: Inter, -apple-system, BlinkMacSystemFont,
               'Segoe UI', system-ui, sans-serif;
  font-size: var(--text-body); line-height: 1.7;
  color: var(--text-primary); background: var(--bg-primary);
  min-height: 100vh; overflow-x: hidden;
}
h1, h2, h3, h4, h5 {
  font-family: Georgia, 'Times New Roman', serif;
  font-weight: normal; line-height: 1.2;
}
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
button { cursor: pointer; border: none; background: none; font: inherit; }
input, textarea {
  font: inherit; border-radius: var(--radius-input);
  border: 1px solid var(--border-card);
  background: var(--bg-card); color: var(--text-primary);
  padding: var(--space-2) var(--space-3);
}
.container { max-width: 1280px; margin: 0 auto; padding: 0 var(--space-3); }
.section { padding: var(--space-9) 0; }
.grid { display: grid; gap: var(--space-3); }
@media (min-width: 1024px) {
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .grid-2 { grid-template-columns: repeat(2, 1fr); }
  .grid-4 { grid-template-columns: repeat(4, 1fr); }
}
@media (min-width: 768px) and (max-width: 1023px) {
  .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .section { padding: var(--space-7) 0; }
  .container { padding: 0 var(--space-2); }
}
@media (max-width: 767px) {
  .grid-3, .grid-4, .grid-2 { grid-template-columns: 1fr; }
  .section { padding: var(--space-6) 0; }
  .container { padding: 0 var(--space-2); }
}
.card {
  background: var(--bg-card);
  backdrop-filter: blur(20px) saturate(150%);
  border: 1px solid var(--border-card);
  box-shadow:
    0 0 40px var(--glow-teal),
    0 0 80px var(--glow-teal-lg),
    0 8px 32px rgba(0,0,0,0.2);
  border-radius: var(--radius-card);
  padding: var(--space-4);
}
.btn {
  display: inline-flex; align-items: center;
  justify-content: center; gap: var(--space-1);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-pill);
  font-size: var(--text-cta); font-weight: 500;
  letter-spacing: 0.06em; text-decoration: none;
  transition: transform var(--t-hover), box-shadow var(--t-hover);
}
.btn-primary {
  background: var(--accent-violet);
  color: var(--text-primary);
  box-shadow: 0 0 40px rgba(123,79,232,0.3);
}
.btn-secondary {
  background: transparent;
  color: var(--accent-teal);
  border: 1px solid var(--border-card);
}
.label {
  font-size: var(--text-label); font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--accent-teal);
}
```

