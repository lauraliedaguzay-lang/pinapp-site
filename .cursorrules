<section class="section" style="background:var(--bg-deep);"
         data-chapter="auralis">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;
                gap:var(--space-6);align-items:center;">

      <!-- Texte gauche -->
      <div>
        <p class="label section-enter" style="margin-bottom:var(--space-2);">
          PRODUIT PINAPP · EN DÉVELOPPEMENT
        </p>
        <h2 class="section-enter stagger-1"
            style="font-size:var(--text-h1);letter-spacing:-0.02em;
                   margin-bottom:var(--space-3);">
          La preuve par l'exemple.
        </h2>
        <p class="section-enter stagger-2"
           style="opacity:0.7;margin-bottom:var(--space-2);">
          Auralis RH — conçu par Pinapp.
          Un assistant IA qui prévient le burnout avant qu'il n'arrive.
        </p>
        <p class="section-enter stagger-3"
           style="opacity:0.7;margin-bottom:var(--space-5);">
          Pinapp l'a pensé, conçu et structuré.
          Votre projet mérite le même niveau d'exigence.
        </p>
        <div class="section-enter stagger-4"
             style="display:flex;gap:var(--space-2);
                    align-items:center;flex-wrap:wrap;">
          <span style="background:var(--accent-green);
                       color:#050A14;font-size:11px;
                       font-weight:600;padding:4px 12px;
                       border-radius:100px;">
            Concours Lépine 2026
          </span>
          <a href="/diagnostic/?projet=auralis"
             style="font-size:14px;color:var(--accent-teal);">
            En savoir plus →
          </a>
        </div>
      </div>

      <!-- Mockup iPhone Auralis -->
      <div class="section-enter stagger-1"
           style="display:flex;justify-content:center;">
        <!-- Mockup iPhone CSS pur -->
        <div style="width:240px;height:480px;
                    background:#0A1628;
                    border-radius:32px;
                    border:2px solid rgba(0,229,204,0.2);
                    box-shadow:
                      0 0 40px rgba(0,229,204,0.08),
                      0 0 80px rgba(0,229,204,0.04);
                    display:flex;flex-direction:column;
                    align-items:center;justify-content:center;
                    padding:var(--space-4);gap:var(--space-3);">

          <!-- Logo Auralis -->
          <p style="font-family:Georgia;font-size:14px;
                    color:var(--accent-teal);letter-spacing:0.1em;">
            AURALIS RH
          </p>

          <!-- Score ring SVG r=36 circumference=226 -->
          <svg width="100" height="100" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="36"
                    fill="none" stroke="rgba(0,229,204,0.15)"
                    stroke-width="3"/>
            <circle cx="50" cy="50" r="36"
                    fill="none" stroke="#00E5CC"
                    stroke-width="3"
                    stroke-dasharray="226"
                    stroke-dashoffset="68"
                    stroke-linecap="round"
                    transform="rotate(-90 50 50)"/>
            <text x="50" y="50" text-anchor="middle"
                  dominant-baseline="central"
                  font-family="Inter" font-size="20"
                  font-weight="600" fill="#E8F4F8">82</text>
            <text x="50" y="65" text-anchor="middle"
                  font-family="Inter" font-size="8"
                  fill="rgba(232,244,248,0.5)">/100</text>
          </svg>

          <!-- Barre bien-être -->
          <div style="width:100%;">
            <p style="font-size:10px;opacity:0.5;
                      margin-bottom:6px;font-family:Inter;
                      letter-spacing:0.1em;">BIEN-ÊTRE</p>
            <div style="height:3px;background:rgba(0,229,204,0.15);
                        border-radius:100px;">
              <div class="auralis-bar"
                   style="height:3px;width:68%;"></div>
            </div>
          </div>

          <!-- Message Aurora -->
          <div style="background:rgba(0,229,204,0.05);
                      border:1px solid rgba(0,229,204,0.1);
                      border-radius:12px;padding:10px;width:100%;">
            <p style="font-size:11px;opacity:0.7;
                      font-family:Inter;line-height:1.5;">
              Votre semaine semble chargée.
              Une pause de 10 min est disponible.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
```

