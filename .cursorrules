### ⑧ ONBOARDING

```html
<section class="section" style="background:var(--bg-deep);"
         data-chapter="engagement" id="contact">
  <div class="container" style="max-width:600px;text-align:center;">
    <p class="label section-enter" style="margin-bottom:var(--space-2);">
      VOTRE PROJET
    </p>
    <h2 class="section-enter stagger-1"
        style="font-size:var(--text-h1);letter-spacing:-0.02em;
               margin-bottom:var(--space-2);">
      Votre projet commence ici.
    </h2>
    <p class="section-enter stagger-2"
       style="opacity:0.6;margin-bottom:var(--space-5);">
      Quelques secondes. Pas de formulaire interminable.
    </p>

    <!-- Progress bar -->
    <div style="height:2px;background:var(--border-card);
                border-radius:100px;margin-bottom:var(--space-5);">
      <div class="onboarding-bar" id="onboardingProgress"
           style="height:2px;width:25%;
                  transition:width 300ms ease;"></div>
    </div>

    <!-- Questions -->
    <div style="position:relative;min-height:200px;">

      <!-- Q1 -->
      <div class="question active" id="q1">
        <p style="font-size:18px;margin-bottom:var(--space-3);">
          Vous avez besoin de ?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);
                    justify-content:center;">
          <button class="pill-btn" data-q="1" data-val="automatisation">
            Automatisation
          </button>
          <button class="pill-btn" data-q="1" data-val="site">
            Site premium
          </button>
          <button class="pill-btn" data-q="1" data-val="ia">
            Système IA
          </button>
          <button class="pill-btn" data-q="1" data-val="sais-pas">
            Je ne sais pas encore
          </button>
        </div>
      </div>

      <!-- Q2 -->
      <div class="question" id="q2">
        <p style="font-size:18px;margin-bottom:var(--space-3);">
          Votre structure ?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);
                    justify-content:center;">
          <button class="pill-btn" data-q="2" data-val="independant">
            Indépendant
          </button>
          <button class="pill-btn" data-q="2" data-val="pme">PME</button>
          <button class="pill-btn" data-q="2" data-val="startup">
            Startup
          </button>
          <button class="pill-btn" data-q="2" data-val="grand-compte">
            Grand compte
          </button>
        </div>
      </div>

      <!-- Q3 -->
      <div class="question" id="q3">
        <p style="font-size:18px;margin-bottom:var(--space-3);">
          Votre délai idéal ?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);
                    justify-content:center;">
          <button class="pill-btn" data-q="3" data-val="urgent">
            Urgent — moins de 2 semaines
          </button>
          <button class="pill-btn" data-q="3" data-val="rapide">
            Rapide (1 mois)
          </button>
          <button class="pill-btn" data-q="3" data-val="serein">
            Serein (+2 mois)
          </button>
        </div>
      </div>

      <!-- Q4 -->
      <div class="question" id="q4">
        <p style="font-size:18px;margin-bottom:var(--space-3);">
          Une idée du budget ?
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);
                    justify-content:center;">
          <button class="pill-btn" data-q="4" data-val="moins-1000">
            Moins de 1000€
          </button>
          <button class="pill-btn" data-q="4" data-val="1000-3000">
            1000–3000€
          </button>
          <button class="pill-btn" data-q="4" data-val="plus-3000">
            3000€+
          </button>
          <button class="pill-btn" data-q="4" data-val="a-definir">
            À définir ensemble
          </button>
        </div>
      </div>

      <!-- Fin -->
      <div class="question" id="qfin">
        <div class="check-final"
             style="width:48px;height:48px;margin:0 auto var(--space-3);">
          <svg viewBox="0 0 48 48" fill="none"
               stroke="var(--accent-green)" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round">
            <circle cx="24" cy="24" r="22"/>
            <polyline class="checkmark" points="14,24 20,30 34,16"/>
          </svg>
        </div>
        <h3 id="finMessage" style="font-size:20px;margin-bottom:var(--space-2);">
          C'est tout. Je vous réponds sous 24h.
        </h3>
        <p style="font-size:14px;opacity:0.6;">
          lauralie.daguzay@pinapp.fr
        </p>
      </div>
    </div>

    <!-- RGPD -->
    <p style="font-size:var(--text-legal);opacity:0.4;
              margin-top:var(--space-4);">
      Vos données sont utilisées uniquement pour répondre à votre demande.
      Aucun démarchage. Conformément à notre
      <a href="/legal/confidentialite.html"
         style="text-decoration:underline;">politique de confidentialité</a>.
    </p>
  </div>
</section>

<!-- JS Onboarding -->
<script>
const answers = {};
const progressMap = {1:25, 2:50, 3:75, 4:100};

document.querySelectorAll('.pill-btn').forEach(btn => {
  btn.style.cssText = `padding:10px 20px;border-radius:100px;
    border:1px solid var(--border-card);font-size:14px;
    color:var(--text-primary);background:transparent;
    cursor:pointer;transition:all 200ms ease;`;

  btn.addEventListener('click', () => {
    const q = parseInt(btn.dataset.q);
    answers[q] = btn.dataset.val;

    // Progress
    document.getElementById('onboardingProgress')
      .style.width = progressMap[q] + '%';

    // Transition message
    const messages = {
      1:'Bien noté.', 2:'Parfait.', 3:'On y est presque.'
    };

    if (q < 4) {
      const msg = document.createElement('div');
      msg.className = 'transition-msg';
      msg.textContent = messages[q];
      msg.style.cssText = `position:absolute;top:50%;left:50%;
        transform:translate(-50%,-50%);font-size:18px;
        color:var(--accent-teal);pointer-events:none;`;
      document.querySelector('[style*="min-height"]')
        .appendChild(msg);

      document.getElementById('q'+q).classList.remove('active');
      setTimeout(() => {
        msg.remove();
        document.getElementById('q'+(q+1)).classList.add('active');
      }, 700);
    } else {
      // Q4 — envoyer vers Make/Tally
      document.getElementById('q4').classList.remove('active');
      document.getElementById('onboardingProgress').style.width = '100%';

      // Message conditionnel
      if (answers[4] === 'moins-1000') {
        document.getElementById('finMessage').textContent =
          'Parfait pour notre Starter à 297€. Je reviens vers vous sous 24h.';
      }

      document.getElementById('qfin').classList.add('active');

      // Envoyer données
      /* CONFIGURATION MAKE/TALLY :
         fetch('[URL_WEBHOOK_MAKE]', {
           method: 'POST',
           headers: {'Content-Type': 'application/json'},
           body: JSON.stringify(answers)
         }); */
      console.log('Réponses onboarding:', answers);
    }
  });
});
</script>
```

### ⑨ FAQ

```html
<section class="section" data-chapter="faq">
  <div class="container" style="max-width:700px;">
    <h2 class="section-enter"
        style="font-size:var(--text-h1);text-align:center;
               letter-spacing:-0.02em;margin-bottom:var(--space-6);">
      Questions fréquentes.
    </h2>

    <div id="faqList">
      <!-- FAQ Item template — répéter pour chaque question -->
      <div class="faq-item section-enter"
           style="border-bottom:1px solid var(--separator);">
        <button class="faq-trigger"
                style="width:100%;text-align:left;
                       padding:var(--space-3) 0;
                       display:flex;justify-content:space-between;
                       align-items:center;font-size:16px;
                       color:var(--text-primary);">
          Je n'y connais rien en tech — est-ce que ça me convient ?
          <span class="faq-chevron" style="opacity:0.5;">↓</span>
        </button>
        <div class="faq-content">
          <p style="padding-bottom:var(--space-3);
                    opacity:0.7;font-size:14px;line-height:1.7;">
            C'est exactement pour ça que Pinapp existe.
            Vous n'avez pas besoin de comprendre la technique —
            c'est mon travail. Vous avez besoin de savoir ce que
            vous voulez obtenir. On commence par là.
          </p>
        </div>
      </div>

      <div class="faq-item section-enter stagger-1"
           style="border-bottom:1px solid var(--separator);">
        <button class="faq-trigger"
                style="width:100%;text-align:left;
                       padding:var(--space-3) 0;
                       display:flex;justify-content:space-between;
                       align-items:center;font-size:16px;
                       color:var(--text-primary);">
          Combien de temps ça prend ?
          <span class="faq-chevron" style="opacity:0.5;">↓</span>
        </button>
        <div class="faq-content">
          <p style="padding-bottom:var(--space-3);
                    opacity:0.7;font-size:14px;line-height:1.7;">
            Entre 48h et 15 jours selon la mission.
            Un site simple : 5–7 jours.
            Une automatisation : 3–5 jours.
            Un système complet : 10–15 jours.
            Le Starter est livré en 48h garanti.
          </p>
        </div>
      </div>

      <div class="faq-item section-enter stagger-2"
           style="border-bottom:1px solid var(--separator);">
        <button class="faq-trigger"
                style="width:100%;text-align:left;
                       padding:var(--space-3) 0;
                       display:flex;justify-content:space-between;
                       align-items:center;font-size:16px;
                       color:var(--text-primary);">
          Et si ça ne me convient pas ?
          <span class="faq-chevron" style="opacity:0.5;">↓</span>
        </button>
        <div class="faq-content">
          <p style="padding-bottom:var(--space-3);
                    opacity:0.7;font-size:14px;line-height:1.7;">
            Révision offerte si le livrable ne correspond pas
            au brief validé ensemble. L'acompte de 50% reste acquis
            si on a démarré — mais on ne s'arrête pas tant que
            vous n'êtes pas satisfait.
          </p>
        </div>
      </div>

      <div class="faq-item section-enter stagger-3"
           style="border-bottom:1px solid var(--separator);">
        <button class="faq-trigger"
                style="width:100%;text-align:left;
                       padding:var(--space-3) 0;
                       display:flex;justify-content:space-between;
                       align-items:center;font-size:16px;
                       color:var(--text-primary);">
          Vous travaillez avec quel type d'entreprise ?
          <span class="faq-chevron" style="opacity:0.5;">↓</span>
        </button>
        <div class="faq-content">
          <p style="padding-bottom:var(--space-3);
                    opacity:0.7;font-size:14px;line-height:1.7;">
            TPE, PME, indépendants — tous secteurs.
            Artisans, restaurateurs, coachs, avocats,
            esthéticiennes, consultants...
            Si vous avez des tâches répétitives ou besoin
            d'une présence digitale premium — Pinapp est fait pour vous.
          </p>
        </div>
      </div>

      <div class="faq-item section-enter stagger-4"
           style="border-bottom:1px solid var(--separator);">
        <button class="faq-trigger"
                style="width:100%;text-align:left;
                       padding:var(--space-3) 0;
                       display:flex;justify-content:space-between;
                       align-items:center;font-size:16px;
                       color:var(--text-primary);">
          Comment se passe le paiement ?
          <span class="faq-chevron" style="opacity:0.5;">↓</span>
        </button>
        <div class="faq-content">
          <p style="padding-bottom:var(--space-3);
                    opacity:0.7;font-size:14px;line-height:1.7;">
            50% à la commande, 50% à la livraison.
            Virement bancaire ou carte via Stripe.
            TVA non applicable — Article 293B du CGI.
            Devis valable 15 jours.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.querySelectorAll('.faq-trigger').forEach(trigger => {
  trigger.addEventListener('click', () => {
    const item = trigger.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i =>
      i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  });
});
</script>
```

