# Auth basique uniquement pour /dashboard/
# Remplacez AuthUserFile par le chemin ABSOLU du fichier .htpasswd (hPanel Hostinger : Fichiers → clic droit → chemin).
# Exemple type : /home/u123456789/domains/pinapp.fr/public_html/.htpasswd
AuthType Basic
AuthName "Pinapp"
AuthUserFile "/home/REMPLACER_PAR_VOTRE_CHEMIN/.htpasswd"
Require valid-user
